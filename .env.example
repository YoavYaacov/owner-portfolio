# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real values (Master Prompt §10).
#
# Both of these are PUBLIC values by design (the anon key is meant to be
# shipped to the browser; it has no power beyond what RLS allows it — see
# supabase/migrations/20260728091000_rls_policies.sql). The service role key
# must NEVER appear here or anywhere in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
